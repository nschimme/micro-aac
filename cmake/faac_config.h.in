#ifndef FAAC_CONFIG_H
#define FAAC_CONFIG_H

#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <stdint.h>

#define PACKAGE "micro-aac"
#define PACKAGE_VERSION "0.1.0"

#ifndef MAX_CHANNELS
#define MAX_CHANNELS @MAX_CHANNELS@
#endif

#ifndef FAAC_ENCODER_SBR
#define FAAC_ENCODER_SBR 1
#endif

/* PS encoding disabled due to patents */
#ifndef FAAC_ENCODER_PS
#define FAAC_ENCODER_PS 0
#endif

#ifndef FAAC_ENCODER_DRC
#define FAAC_ENCODER_DRC 0
#endif

#ifndef FAAC_SBR_DECIMATION
#define FAAC_SBR_DECIMATION @FAAC_SBR_DECIMATION@
#endif

#undef FAAC_STATS
#undef FAAD_STATS

/* FAAD decoder feature trimming */
#cmakedefine FAAD_DISABLE_SBR 1
#cmakedefine FAAD_DISABLE_PS 1

#ifndef FAAD_DISABLE_DAB
#define FAAD_DISABLE_DAB 1
#endif

#ifndef FAAD_DISABLE_DRC
#define FAAD_DISABLE_DRC 1
#endif

#endif /* FAAC_CONFIG_H */
